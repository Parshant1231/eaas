pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 10, unit: 'MINUTES')
    }

    parameters {
        string(name: 'ENV_NAME', defaultValue: 'demo',
               description: '3-20 chars: lowercase letters, digits, hyphens; starts with a letter')
        choice(name: 'SIZE', choices: ['small', 'medium'], description: 'Environment size')
        choice(name: 'TTL_HOURS', choices: ['1', '2', '4'], description: 'Hours until auto-destroy')
    }

    stages {
        stage('Validate input') {
            steps {
                sh '''
                    echo "$ENV_NAME" | grep -Eq '^[a-z][a-z0-9-]{2,19}$' || {
                        echo "ERROR: invalid ENV_NAME '$ENV_NAME'"
                        exit 1
                    }
                '''
            }
        }

        stage('Hello EaaS') {
            steps {
                sh '''
                    echo "Hello from EaaS"
                    echo "env=$ENV_NAME size=$SIZE ttl=${TTL_HOURS}h"
                    echo "running as: $(whoami) at $(date -u)"
                '''
            }
        }
    }

    post {
        success { echo "Pipeline finished OK for ${params.ENV_NAME}" }
        failure { echo "Pipeline FAILED for ${params.ENV_NAME}" }
    }
}
