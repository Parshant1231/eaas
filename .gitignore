# Secrets and local config
.env
!.env.example
*.pem
*.key

# Terraform: state can contain secrets, so it never goes in Git
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Node
node_modules/

# Jenkins local data (if we bind-mount it)
jenkins_home/

# OS noise
.DS_Store

# Terraform local config and saved plans
backend.hcl
*.tfplan

# Ansible generated inventory (per-environment, rendered at run time)
ansible/inventory/generated/

# Pipeline working data (never committed)
.tfdata/
.kube/

# Portal build output
portal/dist/

# Lambda build output
terraform/guardrails/.build/

# Failure injection output (written to the workspace by scripts/inject-failure.sh)
recovery.json

# Scan output
security-report/
